    "dueffe-health": {
      "name": "Health",
      "category": "android",
      "platforms": [
        "android"
      ],
      "about": "Terapie, visite e documenti sanitari, solo sul tuo dispositivo. Organizza i farmaci con orari e promemoria, tieni traccia delle visite e conserva referti e ricette in un unico posto. App nativa della famiglia Dueffe.",
      "features": [
        "Terapie con frequenza, giorni e orari scelti con semplici selettori, e promemoria per ogni dose.",
        "Terapie al bisogno senza avvisi automatici: le assunzioni si segnano dalla lista Terapie.",
        "Storico delle dosi assunte.",
        "Visite mediche e documenti sanitari, con allegati salvati nello spazio privato dell'app.",
        "Moduli guidati a passaggi per farmaci, visite e documenti.",
        "Dati solo sul dispositivo, con backup JSON da esportare e importare dalle Impostazioni."
      ]
